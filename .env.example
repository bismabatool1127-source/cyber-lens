# Cyber-Lens environment configuration
# Copy to .env and adjust as needed. All values have safe defaults.

# Server
PORT=3000
NODE_ENV=development

# SQLite database file location
DB_PATH=./server/data/cyberlens.db

# Live threat feed (OpenPhish community feed). Leave empty to disable live feed entirely.
FEED_URL=https://openphish.com/feed.txt
# Refresh interval in milliseconds (default: 6 hours)
FEED_REFRESH_MS=21600000
# Maximum number of feed entries kept in memory
FEED_MAX_ENTRIES=5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SCAN_RATE_LIMIT_MAX=20
